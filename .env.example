# ---------------------------------------------------------------------------
# AI Video Summarizer & Translator - environment configuration
# Copy this file to `.env` (backend/.env is loaded automatically) and fill in
# the values. NEVER commit real keys.
# ---------------------------------------------------------------------------

# --- AI provider ------------------------------------------------------------
# Which provider implementation to use:
#   openai  -> any OpenAI-compatible API (OpenAI, Groq, OpenRouter, LM Studio,
#              local llama.cpp server, etc.)
#   gemini  -> Google Gemini (Generative Language API). If GEMINI_API_KEY is
#              set and AI_PROVIDER is left blank, this is selected automatically.
#   mock    -> testing only. Returns canned pipeline data without any AI calls.
AI_PROVIDER=openai

# REQUIRED for `openai` provider. Server-side only - never exposed to the browser.
AI_API_KEY=

# Google Gemini key - used when AI_PROVIDER=gemini (or auto-detected when
# AI_API_KEY is empty). Server-side only.
GEMINI_API_KEY=

# Base URL of an OpenAI-compatible API. Examples:
#   OpenAI  : https://api.openai.com/v1
#   Groq    : https://api.groq.com/openai/v1      (free tier, whisper + llama)
#   OpenRouter: https://openrouter.ai/api/v1
# Ignored when AI_PROVIDER=gemini (defaults to https://generativelanguage.googleapis.com/v1beta).
AI_BASE_URL=https://api.openai.com/v1

# Chat model used for summarization + translation.
# gemini examples: gemini-2.5-flash, gemini-2.5-pro
AI_MODEL=gpt-4o-mini

# Speech-to-text model used for transcription + language detection.
# For gemini this is the model that receives the audio inline (same family as AI_MODEL).
AI_TRANSCRIPTION_MODEL=whisper-1

# Timeout (ms) for a single AI request.
AI_TIMEOUT_MS=120000

# --- Server -----------------------------------------------------------------
PORT=4000
# Comma separated list of origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logging -----------------------------------------------------------------
# Minimum level: error | warn | info | http | debug
# (default: http in development, info in production)
LOG_LEVEL=http
# Directory for rotated log files (app.log, error.log). Relative paths resolve
# against the repository root.
LOG_DIR=logs
# Set to false to disable file logging.
LOG_TO_FILE=true
# Set to false to silence console output.
LOG_TO_CONSOLE=true

# --- Limits & security ------------------------------------------------------
MAX_VIDEO_MB=200
MAX_URL_DOWNLOAD_MB=200
URL_DOWNLOAD_TIMEOUT_MS=120000
VIDEO_URL_TIMEOUT_MS=120000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ANALYZE_RATE_LIMIT_MAX=10

# --- Temporary files --------------------------------------------------------
# Uploaded/downloaded videos and generated audio are deleted after this many
# ms. (default: 30 minutes)
TEMP_FILE_TTL_MS=1800000
# How often the cleanup sweep runs (default: 5 minutes)
CLEANUP_INTERVAL_MS=300000

# --- Optional: speech / music source separation -----------------------------
# If `demucs` (https://github.com/adefossez/demucs) is installed and Python is
# available, set this to true to run two-stem vocal separation before
# transcription. When false (default), a robust ffmpeg-based fallback is used:
# band filtering + FFT noise reduction + loudness normalisation.
DEMUCS_ENABLED=false
DEMUCS_COMMAND=demucs
